{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oca-services.local/schemas/service-structure.schema.json",
  "title": "Service-structure skeleton (L1)",
  "description": "Ordered skeleton of a service. Lives in service-structure/*.json. Drives the assembler's high-level shape.",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "_meta":    { "$ref": "./_defs.schema.json#/$defs/Meta" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "blocks"],
        "properties": {
          "id":     { "type": "string", "minLength": 1 },
          "label":  { "type": "string" },
          "note":   { "type": "string" },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items":   { "$ref": "./_defs.schema.json#/$defs/StructureBlock" }
          }
        }
      }
    }
  }
}
