# Observability — all optional; unset = no-op.
# Docs: server-lib/observability/README.md

# Sentry error tracking
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENV=production
# SENTRY_RELEASE=$RAILWAY_GIT_COMMIT_SHA

# Structured log verbosity: silent | error | warn | info | debug
# LOG_LEVEL=info

# Environment
# NODE_ENV=production
